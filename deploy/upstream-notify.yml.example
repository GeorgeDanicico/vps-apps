# Optional: copy to .github/workflows/notify-vps.yml in each application repo.
name: Notify VPS deployments
on:
  push:
    branches: [main]
permissions:
  contents: read
jobs:
  notify:
    runs-on: ubuntu-latest
    steps:
      - name: Wake the central deployment workflow
        env:
          GH_TOKEN: ${{ secrets.VPS_DISPATCH_TOKEN }}
        run: |
          gh api --method POST repos/GeorgeDanicico/vps-apps/dispatches \
            -f event_type=upstream-changed
